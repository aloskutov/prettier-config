{
  "$schema": "http://json.schemastore.org/prettierrc",
  "trailingComma": "all",
  "printWidth": 100,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": [
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "options": {
        "parser": "jsonc"
      }
    }
  ]
}